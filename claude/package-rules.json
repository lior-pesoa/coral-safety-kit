{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(bun add *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Bash(bunx *)",
      "Edit(./package.json)",
      "Edit(./**/package.json)"
    ],
    "allow": [
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(pnpm install --frozen-lockfile)"
    ]
  }
}
