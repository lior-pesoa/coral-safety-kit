# coral-safety-kit · .npmrc for a project (or ~/.npmrc for every project)

# Don't run install scripts (preinstall, install, postinstall). Most npm worms start there.
# On npm 12, dependency scripts are already blocked unless package.json allowScripts lists them;
# this line keeps older npm safe too.
ignore-scripts=true

# Only install versions published at least 7 days ago (npm 11.10 and later). Most malicious
# versions are found and removed within hours.
min-release-age=7

# Optional: send every install through your company registry or a scanning proxy.
# registry=https://npm.your-company.com/
